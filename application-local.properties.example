# Copie para src/main/resources/application-local.properties e preencha.
# Esse arquivo esta no .gitignore: NAO vai para o Git, e e carregado
# automaticamente (spring.config.import no application.properties).

# Senha do saideira_user no seu Postgres local
spring.datasource.password=

# Segredo do JWT (32+ caracteres). Gere no PowerShell com:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
app.jwt.secret=

# Opcional: seu e-mail de conta local, para testar a area de admin
# app.admin.emails=
